# Public configuration for the Bench Supply mobile app.
#
# Copy this file to .env and fill in the real values. .env is gitignored.
# Both EXPO_PUBLIC_ values are baked into the app bundle, so they must only ever
# hold public credentials: the Supabase anon key is designed to be public.
#
# Never put any of these in this file or in the app:
#   SUPABASE_SERVICE_ROLE_KEY
#   MAILGUN_API_KEY
#   MAILGUN_DOMAIN
#   any database password

# The same Supabase project the web shop uses. Supabase dashboard > Project
# Settings > Data API. The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The deployed web shop. It serves the product images from /products/* and owns
# /api/checkout, which is where place_order and the Mailgun email run.
#
# It must be the live address, not localhost: a physical Android phone cannot
# reach a development machine on your laptop.
EXPO_PUBLIC_API_URL=https://raycoder-electronics-shop.vercel.app